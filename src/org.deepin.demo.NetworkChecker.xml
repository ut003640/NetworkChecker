<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/software/dbus/1.0/dbus-spec.dtd">
<node name="/">
  <interface name="org.deepin.demo.NetworkChecker">
    <method name="isOnline">
      <arg name="interfacename" type="s" direction="in"/>
      <arg name="byHostname" type="b" direction="in"/>
      <arg name="online" type="b" direction="out"/>
    </method>
    <method name="setPrimaryInterface">
      <arg name="interfacename" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
  </interface>
</node>
